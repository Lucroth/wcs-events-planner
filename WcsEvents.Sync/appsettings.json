{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "ConnectionStrings": {
    "Db": "Data Source=wcs-events.db"
  },
  "Crawl": {
    "RequestsPerSecond": 6,
    "MissStreakStop": 500,
    "RefreshSkipRecent": "1.00:00:00",
    "UserAgent": "wcs-events/1.0 (Polish WCS event planner)"
  }
}